# Copy to backend/.env once; never overwrite an existing private configuration.
# Required: supply GROQ_API_KEY plus distinct, randomly generated reader/admin keys.
# Leave credentials blank in this versioned template. Never commit backend/.env.
# Run local backend/CLI commands from backend/ so Settings finds its .env file.
# Docker: docker compose --env-file backend/.env up -d --build
# Other defaults are defined in legal_rag.infrastructure.settings.Settings.

# ── LLM backend ──────────────────────────────────────────────────────
# Groq is the supported answer provider.
LEGAL_RAG_LLM_PROVIDER=groq
# Leave LEGAL_RAG_LLM_BASE_URL unset to use Groq's endpoint.
LEGAL_RAG_LLM_TEMPERATURE=0.0
LEGAL_RAG_GREETING_TEMPERATURE=0.8
LEGAL_RAG_UNSUPPORTED_RESPONSE_TEMPERATURE=0.7
LEGAL_RAG_LLM_TIMEOUT_SECONDS=30
LEGAL_RAG_LLM_MAX_RETRIES=3
LEGAL_RAG_MCP_TIMEOUT_SECONDS=30

# ── API security ─────────────────────────────────────────────────────
# Production HTTP startup requires two different nonempty keys.
# Only the reader key may be included in the public browser build.
# Browser users can extract that reader key; it is not a private user credential.
# Keep GROQ_API_KEY and LEGAL_RAG_ADMIN_API_KEY exclusively on the backend.
LEGAL_RAG_DEVELOPMENT_MODE=false
LEGAL_RAG_API_KEY=
# Backend only. Required for /api/ingest and /api/upload, including development.
LEGAL_RAG_ADMIN_API_KEY=
# For local anonymous reads, explicitly set LEGAL_RAG_DEVELOPMENT_MODE=true.
# This never bypasses administrator authentication for writes.

# ── Retrieval knobs ──────────────────────────────────────────────────
LEGAL_RAG_CHUNK_SIZE_TOKENS=512
LEGAL_RAG_CHUNK_OVERLAP_TOKENS=50
LEGAL_RAG_TOP_K_CANDIDATES=5
LEGAL_RAG_TOP_N_ANSWERS=3
LEGAL_RAG_HYBRID_ENABLED=true
LEGAL_RAG_RRF_K=60
# These candidate/answer values override the Settings defaults of 20 / 8.
# Optional local model overrides (first use may download weights):
# LEGAL_RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# LEGAL_RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Optional paths: omit to use automatically resolved backend/data defaults.
# Use absolute host paths for local execution, container paths for Docker.
# LEGAL_RAG_DOCS_DIR=/app/data/shared-corpus/contracts
# LEGAL_RAG_CHROMA_DIR=/app/data/chroma
# LEGAL_RAG_MCP_CONFIG_PATH=/app/mcp_servers.json

# ── Agent budgets ────────────────────────────────────────────────────
LEGAL_RAG_AGENT_MAX_STEPS=4
LEGAL_RAG_AGENT_MAX_SECONDS=30
LEGAL_RAG_AGENT_MAX_TOKENS=2000
LEGAL_RAG_AGENT_MAX_COST_USD=0.02

# ── Observability ────────────────────────────────────────────────────
LEGAL_RAG_LOG_LEVEL=INFO
LEGAL_RAG_LOG_FORMAT=json

# ── HTTP / CORS (production) ─────────────────────────────────────────
# Maximum time allowed to transfer a complete request body.
LEGAL_RAG_HTTP_BODY_TIMEOUT_SECONDS=30
# Request/extraction limits; keep nginx's client_max_body_size aligned if changed.
# LEGAL_RAG_HTTP_REQUEST_TIMEOUT_SECONDS=120
# LEGAL_RAG_HTTP_MAX_CONCURRENT_JOBS=4
# LEGAL_RAG_HTTP_MAX_BODY_BYTES=27262976
# LEGAL_RAG_UPLOAD_MAX_FILE_BYTES=26214400
# LEGAL_RAG_UPLOAD_MAX_FILES=4
# LEGAL_RAG_PDF_MAX_PAGES=100
# LEGAL_RAG_PDF_MAX_CHARACTERS=1000000
# LEGAL_RAG_PDF_TIMEOUT_SECONDS=20
# LEGAL_RAG_PDF_MEMORY_MB=512
# JSON array of allowed origins. Set this to your deployed frontend URL(s).
# LEGAL_RAG_CORS_ORIGINS='["https://legal.example.com"]'

# Groq (set LEGAL_RAG_LLM_PROVIDER=groq)
GROQ_API_KEY=
LEGAL_RAG_GROQ_MODEL=openai/gpt-oss-20b

# Optional evaluation paths (defaults are backend/data/evaluation/)
# LEGAL_RAG_EVALUATION_LABELS_PATH=/app/data/evaluation/labels.json
# LEGAL_RAG_EVALUATION_ARTIFACT_DIR=/app/data/evaluation/generated

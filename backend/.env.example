# Copy to backend/.env and supply your Groq API key.
# Other defaults are baked into legal_rag.infrastructure.settings.Settings.

# ── LLM backend ──────────────────────────────────────────────────────
# Groq is the supported answer provider.
LEGAL_RAG_LLM_PROVIDER=groq
# Leave LEGAL_RAG_LLM_BASE_URL unset to use Groq's endpoint.
LEGAL_RAG_LLM_TEMPERATURE=0.0
LEGAL_RAG_LLM_TIMEOUT_SECONDS=30
LEGAL_RAG_LLM_MAX_RETRIES=3

# ── API security ─────────────────────────────────────────────────────
# Production HTTP startup requires two different nonempty keys.
# Only the reader key may be included in the public browser build.
LEGAL_RAG_DEVELOPMENT_MODE=false
LEGAL_RAG_API_KEY=
# Backend only. Required for /api/ingest and /api/upload, including development.
LEGAL_RAG_ADMIN_API_KEY=
# For local anonymous reads, explicitly set LEGAL_RAG_DEVELOPMENT_MODE=true.
# This never bypasses administrator authentication for writes.

# ── Retrieval knobs ──────────────────────────────────────────────────
LEGAL_RAG_CHUNK_SIZE_TOKENS=512
LEGAL_RAG_CHUNK_OVERLAP_TOKENS=50
LEGAL_RAG_TOP_K_CANDIDATES=5
LEGAL_RAG_TOP_N_ANSWERS=3
LEGAL_RAG_HYBRID_ENABLED=true
LEGAL_RAG_RRF_K=60

# ── Agent budgets ────────────────────────────────────────────────────
LEGAL_RAG_AGENT_MAX_STEPS=4
LEGAL_RAG_AGENT_MAX_SECONDS=30
LEGAL_RAG_AGENT_MAX_TOKENS=2000
LEGAL_RAG_AGENT_MAX_COST_USD=0.02

# ── Observability ────────────────────────────────────────────────────
LEGAL_RAG_LOG_LEVEL=INFO
LEGAL_RAG_LOG_FORMAT=json

# ── HTTP / CORS (production) ─────────────────────────────────────────
# Maximum time allowed to transfer a complete request body.
LEGAL_RAG_HTTP_BODY_TIMEOUT_SECONDS=30
# JSON array of allowed origins. Set this to your deployed frontend URL(s).
# LEGAL_RAG_CORS_ORIGINS='["https://<your-vercel-project>.vercel.app","https://<your-domain>"]'

# Groq (set LEGAL_RAG_LLM_PROVIDER=groq)
GROQ_API_KEY=
LEGAL_RAG_GROQ_MODEL=openai/gpt-oss-20b

# Optional evaluation paths (defaults are backend/data/evaluation/)
# LEGAL_RAG_EVALUATION_LABELS_PATH=/app/data/evaluation/labels.json
# LEGAL_RAG_EVALUATION_ARTIFACT_DIR=/app/data/evaluation/generated

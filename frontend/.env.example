# Public build-time configuration consumed by scripts/set-env.js during npm run build.
# The script reads process environment variables; it does NOT load .env files.
# Set these variables in your terminal or hosting provider's build environment.
# For Docker, use backend/.env and the documented Compose --env-file command.
# Never put GROQ_API_KEY or LEGAL_RAG_ADMIN_API_KEY in frontend configuration.
# Any reader key here is embedded in browser JavaScript and is visible to users.
# Rebuild after changing it. Do not commit a populated frontend/.env file.

# Same-origin API (Angular development proxy or Docker nginx):
LEGAL_RAG_API_URL=/api
# Separate API hosting example: https://api.example.com/api
# Use only the reader key matching backend LEGAL_RAG_API_KEY.
LEGAL_RAG_API_KEY=
